# Public frontend URL used for canonical and social preview metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog project credentials
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend: submissions are emailed to NOTIFICATION_EMAILS (comma-separated).
# There is no database, so these emails are the only record of each order.
RESEND_API_KEY=
FROM_EMAIL=orders@lokucaters.com
NOTIFICATION_EMAILS=
# Fallback reply-to when the customer did not give an email address
REPLY_TO_EMAIL=
# Set to false to log instead of sending (local testing only)
EMAIL_ENABLED=true
